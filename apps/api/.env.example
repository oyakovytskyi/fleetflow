# Compose injects these for local runs; copy to `.env` only for running outside Docker.
DEBUG=true
DATABASE_URL=postgresql+asyncpg://fleetflow:fleetflow@postgres:5432/fleetflow
REDIS_URL=redis://redis:6379/0

# Required whenever DEBUG=false. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
