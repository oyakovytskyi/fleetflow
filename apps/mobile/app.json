{
  "expo": {
    "name": "FleetFlow",
    "slug": "fleetflow",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fleetflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fleetflow.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FleetFlow uses your location to show you on the delivery map and share GPS while a delivery is active.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FleetFlow needs background location so dispatch can see your position while a delivery is in progress, even when the app is not open.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.fleetflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2f6fed"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FleetFlow to use your location to show you on the map and share GPS during deliveries.",
          "locationAlwaysAndWhenInUsePermission": "Allow FleetFlow to track your location in the background while a delivery is active.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
