{
  "name": "fleetflow",
  "version": "0.0.1",
  "private": true,
  "description": "FleetFlow — realtime fleet / courier tracking monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@fleetflow/mobile",
    "admin": "npm run dev --workspace=@fleetflow/admin",
    "api": "npm run dev --workspace=@fleetflow/api"
  },
  "engines": {
    "node": ">=20"
  }
}
